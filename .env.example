# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WhatsApp Configuration (Meta WhatsApp Business Platform & Groups API)
# Mode: 'mock' (default for development/preview) or 'production' (requires Meta credentials)
VITE_WHATSAPP_MODE="mock"

# Official Meta Cloud API Credentials (kept server-side in production)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Official WhatsApp Destination Groups (Exact One Group Per Category)
WHATSAPP_GROUP_ID_FARHA="group_farha_qalqilya_01"
WHATSAPP_GROUP_ID_TARHA="group_tarha_qalqilya_02"
WHATSAPP_GROUP_ID_FAZAA="group_fazaa_qalqilya_03"

# Official Test Destination Phone Number (default for connectivity test)
VITE_TEST_WHATSAPP_NUMBER="+962788019331"
